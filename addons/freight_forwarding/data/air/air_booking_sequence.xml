<odoo>
    <record id="seq_air_booking" model="ir.sequence">
        <field name="name">Air Booking No.</field>
        <field name="code">freight.air.booking</field>
        <field name="prefix">WPCBKA%(y)s%(month)s-</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>
</odoo>
