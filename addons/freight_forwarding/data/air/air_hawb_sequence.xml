<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_freight_air_hawb_job_no_exp" model="ir.sequence">
            <field name="name">Air Jobsheet Job Number (Export)</field>
            <field name="code">freight.air.hawb.job_no.exp</field>
            <field name="prefix">JKT-AE/%(y)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_freight_air_hawb_job_no_imp" model="ir.sequence">
            <field name="name">Air Jobsheet Job Number (Import)</field>
            <field name="code">freight.air.hawb.job_no.imp</field>
            <field name="prefix">JKT-AI/%(y)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
