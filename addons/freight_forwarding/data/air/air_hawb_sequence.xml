<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_freight_air_job_job_no_exp" model="ir.sequence">
            <field name="name">Air Jobsheet Job Number (Export)</field>
            <field name="code">freight.air.job.job_no.exp</field>
            <field name="prefix">JKT-AE/%(y)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_freight_air_job_job_no_imp" model="ir.sequence">
            <field name="name">Air Jobsheet Job Number (Import)</field>
            <field name="code">freight.air.job.job_no.imp</field>
            <field name="prefix">JKT-AI/%(y)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- FF-73 hardening: dipakai HANYA kalau freight_type belum terisi
             saat Jobsheet dibuat, supaya job_no tetap tergenerate tanpa
             diam-diam menganggapnya Export/Import. -->
        <record id="seq_freight_air_job_job_no_neutral" model="ir.sequence">
            <field name="name">Air Jobsheet Job Number (Direction Belum Ditentukan)</field>
            <field name="code">freight.air.job.job_no</field>
            <field name="prefix">JKT-AJOB/%(y)s/%(month)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
