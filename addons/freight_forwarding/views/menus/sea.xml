         Inventory". Separate menu/action, same underlying model). -->
    <menuitem id="menu_sub_parent_sea_bl_inventory" name="B/L Inventory"
        parent="menu_parent_sea"
        sequence="15" />

    <menuitem id="menu_sea_bl_code" name="B/L Code"
        parent="menu_sub_parent_sea_bl_inventory"
        action="action_freight_bl_code_sea"
        sequence="5" />

    <menuitem id="menu_sea_bl_master" name="B/L Master"
        parent="menu_sub_parent_sea_bl_inventory"
        action="action_freight_bl_master_sea"
        sequence="10" />

    <!-- SALES -->
    <menuitem id="menu_sub_parent_sea_sales" name="Sales"
        parent="menu_parent_sea"
        sequence="20" />

    <menuitem id="menu_sea_sales_freight_quotation" name="Freight Quotation"
        parent="menu_sub_parent_sea_sales"
        action="action_freight_sea_quotation"
        sequence="10" />

