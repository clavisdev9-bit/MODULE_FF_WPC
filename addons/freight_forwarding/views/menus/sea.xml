    <menuitem id="menu_sub_parent_sea_import" name="Import"
        parent="menu_parent_sea"
        sequence="30" />

    <menuitem id="menu_sea_import_job_fcl" name="Import Job FCL"
        parent="menu_sub_parent_sea_import"
        action="action_sea_hbl_import_fcl"
