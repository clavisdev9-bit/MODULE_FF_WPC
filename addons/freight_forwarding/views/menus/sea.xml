        action="action_sea_booking_export_fcl"
        sequence="10" />
    <menuitem id="menu_sea_export_booking_lcl" name="LCL Booking"
        parent="menu_sub_parent_sea_export_booking"
        action="action_sea_booking_export_lcl"
        sequence="20" />

    <menuitem id="menu_sub_parent_sea_export_job" name="Export Job"
        parent="menu_sub_parent_sea_export"
        sequence="30" />
