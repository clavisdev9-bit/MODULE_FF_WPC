<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ===========================================================         FORM VIEW (Air Quotation - sale.order)
         Meniru struktur Sea Quotation, hanya menampilkan field
         yang ada pada model Air Quotation (tanpa container_type / port sea).
    ============================================================ -->
    <record id="view_air_quotation_form" model="ir.ui.view">
        <field name="name">freight.air.quotation.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="attributes">
                <attribute name="options">{'no_create': False, 'no_create_edit': False, 'no_open': False}</attribute>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="is_freight_quotation" invisible="1" />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_air_bookings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-plane"
                    invisible="not is_freight_quotation or freight_business_type != 'air' or booking_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Booking</span>
                    </div>
                </button>
                <button name="action_view_hawbs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="not is_freight_quotation or freight_business_type != 'air' or hawb_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Jobsheet</span>
                    </div>
                </button>
                <button name="action_view_currency_variants"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not is_freight_quotation or freight_business_type != 'air' or variant_count == 0">
                    <field name="variant_count" widget="statinfo" string="Variants" />
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="freight_type" invisible="not is_freight_quotation" />
                <field name="quotation_title" invisible="not is_freight_quotation" />
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="email" invisible="not is_freight_quotation" />
                <field name="phone" invisible="not is_freight_quotation" />
                <field name="contact_person" invisible="not is_freight_quotation" />
                <field name="salesman_id" invisible="not is_freight_quotation" />
            </xpath>

            <xpath expr="//group[@name='order_details']" position="replace">
                <group name="freight_order_details" invisible="not is_freight_quotation">
                    <field name="currency_id" />
                    <field name="currency_rate" />
                    <field name="pricelist_id" />
                    <field name="payment_term_id" />
                    <field name="service_level" />
                    <field name="pricelist_id" readonly="state in ['cancel', 'sale']"
                        groups="!product.group_product_pricelist" />
                    <field name="delivery_type_id" />
                    <field name="valid_from" />
                    <field name="validity_date" string="Valid To" />
                    <field name="reference_number" />
                    <field name="commodity_id" />
                </group>
            </xpath>

            <xpath expr="//group[@name='sale_header']" position="after">
                <group string="Address" invisible="not is_freight_quotation">
                    <group>
                        <span>Pickup</span>
                        <div class="o_address_format">
                            <field name="pickup_street" placeholder="Street..."
                                class="o_address_street" />
                            <field name="pickup_street2" placeholder="Street 2..."
                                class="o_address_street" />
                            <field name="pickup_city" placeholder="City"
                                class="o_address_city" />
                            <field name="pickup_state_id" placeholder="State"
                                class="o_address_state" />
                            <field name="pickup_zip" placeholder="ZIP"
                                class="o_address_zip" />
                            <field name="pickup_country_id" placeholder="Country"
                                class="o_address_country" />
                        </div>
                    </group>
                    <group name="studio_group_7a4382">
                        <span>Delivery</span>
                        <div class="o_address_format" name="studio_div_8cbbbf">
                            <field name="delivery_street" placeholder="Street..."
                                class="o_address_street" />
                            <field name="delivery_street2" placeholder="Street 2..."
                                class="o_address_street" />
                            <field name="delivery_city" placeholder="City"
                                class="o_address_city" />
                            <field name="delivery_state_id" placeholder="State"
                                class="o_address_state" />
                            <field name="delivery_zip" placeholder="ZIP"
                                class="o_address_zip" />
                            <field name="delivery_country_id" placeholder="Country"
                                class="o_address_country" />
                        </div>
                    </group>
                </group>
            </xpath>

            <xpath expr="//header" position="inside">
                <field name="original_quotation_id" invisible="1"/>
                <button
                    name="action_convert_to_jobsheet_direct"
                    type="object"
                    string="Create Jobsheet"
                    class="oe_highlight"
                    invisible="not is_freight_quotation or freight_business_type != 'air' or freight_type != 'import' or state != 'sale' or booking_count &gt; 0 or hawb_count &gt; 0"
                />
                <button
                    name="action_convert_to_booking_direct"
                    type="object"
                    string="Create Booking"
                    class="oe_highlight"
                    invisible="not is_freight_quotation or freight_business_type != 'air' or freight_type != 'export' or state != 'sale' or booking_count &gt; 0 or hawb_count &gt; 0"
                />
            </xpath>

            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Extra Info">
                    <group>
                        <field name="description_of_goods" />
                        <field name="quantity" />
                        <field name="has_insurance" />
                        <field name="insurance_id" invisible="has_insurance == False" />
                        <field name="loose_quantity" />
                        <field name="uom_id" />
                    </group>
                    <group>
                        <field name="actual_weight" />
                        <field name="volume" />
                        <field name="chargeable_weight" />
                    </group>
                </group>
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Terms &amp; Conditions" invisible="not is_freight_quotation">
                    <field name="terms_and_conditions" placeholder="Terms and conditions..." nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         LIST VIEW
    ============================================================ -->
    <record id="view_air_quotation_list_custom" model="ir.ui.view">
        <field name="name">freight.air.quotation.list.custom</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Number" decoration-bf="1" />
                <field name="create_date" string="Creation Date" />
                <field name="freight_type" string="Quotation Type" />
                <field name="partner_id" string="Customer" />
                <field name="user_id" string="Salesperson" />
                <field name="amount_total" string="Total" />
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'sale'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         SEARCH VIEW
    ============================================================ -->
    <record id="view_air_quotation_search" model="ir.ui.view">
        <field name="name">freight.air.quotation.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Air Quotation">
                <field name="name" string="Quotation Number"/>
                <field name="partner_id"/>
                <field name="user_id" string="Salesperson"/>
                <field name="team_id"/>
                <field name="state"/>
                <field name="freight_type"/>
                <separator/>
                <filter name="my_quotation" string="My Quotations" domain="[('user_id', '=', uid)]"/>
                <filter name="filter_draft_sent" string="Quotation" domain="[('state', 'in', ['draft', 'sent'])]"/>
                <filter name="filter_sale" string="Sales Order" domain="[('state', '=', 'sale')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         WINDOW ACTION
    ============================================================ -->
    <record id="action_freight_air_quotation" model="ir.actions.act_window">
        <field name="name">Air Quotation</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_air_quotation_list_custom"/>
        <field name="search_view_id" ref="view_air_quotation_search"/>
        <field name="domain">[('freight_business_type', '=', 'air'), ('is_freight_quotation', '=', True)]</field>
        <field name="context">{'search_default_my_quotation': 1, 'default_freight_business_type': 'air', 'default_is_freight_quotation': True}</field>
    </record>

    <record id="action_freight_air_quotation_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_air_quotation_list_custom"/>
        <field name="act_window_id" ref="action_freight_air_quotation"/>
    </record>

    <record id="action_freight_air_quotation_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_air_quotation_form"/>
        <field name="act_window_id" ref="action_freight_air_quotation"/>
    </record>
</odoo>
