<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_air_handling_information_form" model="ir.ui.view">
        <field name="name">freight.air.handling.information.form</field>
        <field name="model">freight.air.handling.information</field>
        <field name="arch" type="xml">
            <form string="Handling Information">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_air_handling_information_list" model="ir.ui.view">
        <field name="name">freight.air.handling.information.list</field>
        <field name="model">freight.air.handling.information</field>
        <field name="arch" type="xml">
            <list string="Handling Information">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_freight_air_handling_information" model="ir.actions.act_window">
        <field name="name">Handling Information</field>
        <field name="res_model">freight.air.handling.information</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_freight_air_handling_info"
        name="Handling Information"
        parent="menu_sub_parent_air_master_data"
        action="action_freight_air_handling_information"
        sequence="75"/>
</odoo>