<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_freight" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.freight</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_sea_jobs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-ship"
                    invisible="sea_job_count == 0"
                >
                    <field
                        name="sea_job_count"
                        widget="statinfo"
                        string="Jobsheet"
                    />
                </button>
            </div>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sea_job_id" invisible="not sea_job_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
