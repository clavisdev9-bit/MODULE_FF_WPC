<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         FF-81: Charge Table = native product.pricelist header +
         native product.pricelist.item rules. Native views (list, form,
         search, and the embedded Price Rules list on the Pricelist form)
         are only extended additively; no existing native field is
         hidden/renamed/moved/rewritten.
    ============================================================ -->
    <record id="view_pricelist_item_form_inherit_freight" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.freight</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <group name="pricelist_rule_computation" position="after">
                <group string="Freight Forwarding" name="freight_forwarding_charge_table">
                    <group>
                        <field name="ff_description" readonly="1"/>
                        <field name="ff_cargo" invisible="not context.get('ff_cargo_visible')"/>
                    </group>
                    <group>
                        <field name="ff_uom_id"/>
                        <field name="ff_vat_id"/>
                        <field name="ff_charge_unit"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

    <!-- Additive: surface the FF fields as extra columns on the native
         "Price Rules" list embedded in the Pricelist form. No native
         column is touched. -->
    <record id="view_pricelist_form_inherit_freight" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit.freight</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/list/field[@name='min_quantity']" position="after">
                <field name="ff_description" readonly="1" optional="show"/>
                <field name="ff_uom_id" optional="show"/>
                <field name="ff_vat_id" optional="show"/>
                <field name="ff_charge_unit" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         FF-81: Cost Table = native product.supplierinfo + FF fields.
    ============================================================ -->
    <record id="view_supplierinfo_form_inherit_freight" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit.freight</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Freight Forwarding" name="freight_forwarding_cost_table">
                    <group>
                        <field name="ff_description" readonly="1"/>
                        <field name="ff_cargo" invisible="not context.get('ff_cargo_visible')"/>
                    </group>
                    <group>
                        <field name="ff_uom_id"/>
                        <field name="ff_vat_id"/>
                        <field name="ff_charge_unit"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Additive: surface the FF fields as extra columns on the native
         Vendor Pricelist list. No native column is touched/renamed. -->
    <record id="view_supplierinfo_list_inherit_freight" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.inherit.freight</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_code" position="after">
                <field name="ff_description" readonly="1" optional="show"/>
                <field name="ff_uom_id" optional="show"/>
                <field name="ff_vat_id" optional="show"/>
                <field name="ff_charge_unit" optional="show"/>
            </field>
        </field>
    </record>

    <!-- ============================================================
         Actions: Air vs Sea differentiated only by domain + default
         context (`ff_type` is never shown to the user). Native views are
         used as-is (no view_ids override), so the full native Pricelist /
         Vendor Pricelist experience (header + rules, chatter, etc.) is
         preserved.
    ============================================================ -->
    <record id="action_freight_air_charge_table" model="ir.actions.act_window">
        <field name="name">Charge Table</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'air')]</field>
        <field name="context">{
            'default_ff_type': 'air',
            'default_applied_on': '1_product',
            'default_compute_price': 'fixed',
        }</field>
    </record>

    <record id="action_freight_sea_charge_table" model="ir.actions.act_window">
        <field name="name">Charge Table</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'sea')]</field>
        <field name="context">{
            'default_ff_type': 'sea',
            'default_applied_on': '1_product',
            'default_compute_price': 'fixed',
            'ff_cargo_visible': True,
        }</field>
    </record>

    <record id="action_freight_air_cost_table" model="ir.actions.act_window">
        <field name="name">Cost Table</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'air')]</field>
        <field name="context">{'default_ff_type': 'air', 'visible_product_tmpl_id': False}</field>
    </record>

    <record id="action_freight_sea_cost_table" model="ir.actions.act_window">
        <field name="name">Cost Table</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'sea')]</field>
        <field name="context">{
            'default_ff_type': 'sea',
            'visible_product_tmpl_id': False,
            'ff_cargo_visible': True,
        }</field>
    </record>
</odoo>
