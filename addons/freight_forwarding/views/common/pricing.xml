<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         FF-81: Charge Table = native product.pricelist.item + FF fields.
         Native form (product.product_pricelist_item_form_view) is only
         extended additively with a new "Freight Forwarding" group;
         no existing native field is hidden/renamed/moved.
    ============================================================ -->
    <record id="view_pricelist_item_form_inherit_freight" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.freight</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <group name="pricelist_rule_computation" position="after">
                <group string="Freight Forwarding" name="freight_forwarding_charge_table">
                    <group>
                        <field name="ff_description" readonly="1"/>
                        <field name="ff_cargo" invisible="not context.get('ff_cargo_visible')"/>
                    </group>
                    <group>
                        <field name="ff_uom_id"/>
                        <field name="ff_vat_id"/>
                        <field name="ff_charge_unit"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

    <!-- Dedicated flat list for the Charge Table menu (Air/Sea). Kept
         separate from the native product.pricelist.item.list views (used
         inside Pricelist/Product screens) so those stay untouched. -->
    <record id="view_pricelist_item_freight_charge_table_list" model="ir.ui.view">
        <field name="name">product.pricelist.item.freight.charge.table.list</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <list string="Charge Table" editable="bottom">
                <field name="pricelist_id"/>
                <field name="product_tmpl_id" required="1" options="{'no_create_edit': 1}"/>
                <field name="ff_description" readonly="1"/>
                <field name="ff_cargo" column_invisible="not context.get('ff_cargo_visible')"/>
                <field name="ff_uom_id"/>
                <field name="ff_vat_id"/>
                <field name="ff_charge_unit"/>
                <field name="fixed_price" widget="monetary" string="Amount"
                       options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="min_quantity"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="applied_on" column_invisible="True"/>
                <field name="compute_price" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_pricelist_item_freight_charge_table_search" model="ir.ui.view">
        <field name="name">product.pricelist.item.freight.charge.table.search</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <search string="Charge Table">
                <field name="product_tmpl_id"/>
                <field name="pricelist_id"/>
                <field name="ff_charge_unit"/>
                <group expand="0" string="Group By">
                    <filter name="group_pricelist" string="Pricelist" domain="[]" context="{'group_by': 'pricelist_id'}"/>
                    <filter name="group_charge_unit" string="Charge Unit" domain="[]" context="{'group_by': 'ff_charge_unit'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         FF-81: Cost Table = native product.supplierinfo + FF fields.
    ============================================================ -->
    <record id="view_supplierinfo_form_inherit_freight" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.inherit.freight</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Freight Forwarding" name="freight_forwarding_cost_table">
                    <group>
                        <field name="ff_description" readonly="1"/>
                        <field name="ff_cargo" invisible="not context.get('ff_cargo_visible')"/>
                    </group>
                    <group>
                        <field name="ff_uom_id"/>
                        <field name="ff_vat_id"/>
                        <field name="ff_charge_unit"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_supplierinfo_freight_cost_table_list" model="ir.ui.view">
        <field name="name">product.supplierinfo.freight.cost.table.list</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <list string="Cost Table" editable="bottom">
                <field name="partner_id" required="1"/>
                <field name="product_tmpl_id" required="1" options="{'no_create_edit': 1}"/>
                <field name="ff_description" readonly="1"/>
                <field name="ff_cargo" column_invisible="not context.get('ff_cargo_visible')"/>
                <field name="ff_uom_id"/>
                <field name="ff_vat_id"/>
                <field name="ff_charge_unit"/>
                <field name="price" widget="monetary" string="Amount"
                       options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                <field name="min_qty"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_supplierinfo_freight_cost_table_search" model="ir.ui.view">
        <field name="name">product.supplierinfo.freight.cost.table.search</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <search string="Cost Table">
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <field name="ff_charge_unit"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_charge_unit" string="Charge Unit" domain="[]" context="{'group_by': 'ff_charge_unit'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         Actions: one model per pricing type (Charge Table / Cost Table),
         Air vs Sea differentiated only by domain + default context
         (`ff_type` is never shown to the user).
    ============================================================ -->
    <record id="action_freight_air_charge_table" model="ir.actions.act_window">
        <field name="name">Charge Table</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'air')]</field>
        <field name="context">{
            'default_ff_type': 'air',
            'default_applied_on': '1_product',
            'default_compute_price': 'fixed',
        }</field>
        <field name="search_view_id" ref="view_pricelist_item_freight_charge_table_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pricelist_item_freight_charge_table_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_pricelist_item_form_view')}),
        ]"/>
    </record>

    <record id="action_freight_sea_charge_table" model="ir.actions.act_window">
        <field name="name">Charge Table</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'sea')]</field>
        <field name="context">{
            'default_ff_type': 'sea',
            'default_applied_on': '1_product',
            'default_compute_price': 'fixed',
            'ff_cargo_visible': True,
        }</field>
        <field name="search_view_id" ref="view_pricelist_item_freight_charge_table_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pricelist_item_freight_charge_table_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_pricelist_item_form_view')}),
        ]"/>
    </record>

    <record id="action_freight_air_cost_table" model="ir.actions.act_window">
        <field name="name">Cost Table</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'air')]</field>
        <field name="context">{'default_ff_type': 'air'}</field>
        <field name="search_view_id" ref="view_supplierinfo_freight_cost_table_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_supplierinfo_freight_cost_table_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_supplierinfo_form_view')}),
        ]"/>
    </record>

    <record id="action_freight_sea_cost_table" model="ir.actions.act_window">
        <field name="name">Cost Table</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ff_type', '=', 'sea')]</field>
        <field name="context">{'default_ff_type': 'sea', 'ff_cargo_visible': True}</field>
        <field name="search_view_id" ref="view_supplierinfo_freight_cost_table_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_supplierinfo_freight_cost_table_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_supplierinfo_form_view')}),
        ]"/>
    </record>
</odoo>
