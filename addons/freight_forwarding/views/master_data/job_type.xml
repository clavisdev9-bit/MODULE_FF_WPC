<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_job_type_list" model="ir.ui.view">
        <field name="name">freight.job.type.list</field>
        <field name="model">freight.job.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="business_type"/>
                <field name="freight_type"/>
                <field name="sea_ship_mode"/>
                <field name="module_code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_freight_job_type_form" model="ir.ui.view">
        <field name="name">freight.job.type.form</field>
        <field name="model">freight.job.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="business_type"/>
                        <field name="freight_type"/>
                        <field name="sea_ship_mode" invisible="business_type != 'sea'"/>
                        <field name="module_code"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_job_type_search" model="ir.ui.view">
        <field name="name">freight.job.type.search</field>
        <field name="model">freight.job.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="business_type"/>
                <field name="freight_type"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_business_type" string="Business Type" context="{'group_by': 'business_type'}"/>
                    <filter name="group_by_freight_type" string="Direction" context="{'group_by': 'freight_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_freight_job_type" model="ir.actions.act_window">
        <field name="name">Job Type</field>
        <field name="res_model">freight.job.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freight_job_type_search"/>
    </record>
</odoo>
