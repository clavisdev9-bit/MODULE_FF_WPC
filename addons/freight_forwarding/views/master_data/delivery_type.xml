<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_delivery_type_list" model="ir.ui.view">
        <field name="name">account.incoterms.list.delivery.type</field>
        <field name="model">account.incoterms</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_freight_delivery_type_form" model="ir.ui.view">
        <field name="name">account.incoterms.form.delivery.type</field>
        <field name="model">account.incoterms</field>
        <field name="arch" type="xml">
                <form string="Delivery Type">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freight_delivery_type" model="ir.actions.act_window">
        <field name="name">Delivery Types</field>
        <field name="res_model">account.incoterms</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
