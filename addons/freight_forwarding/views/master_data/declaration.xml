<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_declaration_list" model="ir.ui.view">
        <field name="name">freight.declaration.list</field>
        <field name="model">freight.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="permit_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_freight_declaration_form" model="ir.ui.view">
        <field name="name">freight.declaration.form</field>
        <field name="model">freight.declaration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="permit_id"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_declaration_search" model="ir.ui.view">
        <field name="name">freight.declaration.search</field>
        <field name="model">freight.declaration</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="permit_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_declaration" model="ir.actions.act_window">
        <field name="name">Declaration</field>
        <field name="res_model">freight.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freight_declaration_search"/>
    </record>
</odoo>
