<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_dg_class_code_list" model="ir.ui.view">
        <field name="name">freight.dg.class.code.list</field>
        <field name="model">freight.dg.class.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="un_no"/>
                <field name="imo_class"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_freight_dg_class_code_form" model="ir.ui.view">
        <field name="name">freight.dg.class.code.form</field>
        <field name="model">freight.dg.class.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="un_no"/>
                        </group>
                        <group>
                            <field name="imo_class"/>
                            <field name="group_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freight_dg_class_code" model="ir.actions.act_window">
        <field name="name">DG Class Code</field>
        <field name="res_model">freight.dg.class.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
