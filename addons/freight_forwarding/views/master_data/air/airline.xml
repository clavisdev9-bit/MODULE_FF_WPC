<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action: Airline master data → res.partner filtered by Airline tag -->
    <record id="action_freight_airline" model="ir.actions.act_window">
        <field name="name">Airlines</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('category_id.freight_role_code', '=', 'airline')]</field>
        <field name="context">{
            'default_is_company': True,
            'default_category_id': [('freight_role_code', '=', 'airline')]
        }</field>
    </record>

    <!-- Airline tab on res.partner form (only visible when is_airline = True) -->
    <record id="view_partner_airline_tab" model="ir.ui.view">
        <field name="name">res.partner.form.airline.tab</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Airline" name="airline_info"
                      invisible="not is_airline">
                    <group string="Airline Information">
                        <group>
                            <field name="airline_code"/>
                            <field name="airline_identifier"/>
                            <field name="airline_iata_code"/>
                            <field name="airline_terminal"/>
                            <field name="airline_commission_percentage"/>
                        </group>
                        <group>
                            <field name="airline_neutral_awb"/>
                            <field name="airline_ccn"/>
                            <field name="airline_analysis_code"/>
                        </group>
                    </group>
                    <group string="AWB Print Layout">
                        <group>
                            <field name="airline_column_offset"/>
                            <field name="airline_row_offset"/>
                        </group>
                        <group>
                            <field name="airline_left_margin"/>
                            <field name="airline_top_margin"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
