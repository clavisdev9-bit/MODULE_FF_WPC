<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_sea_charge_table_list" model="ir.ui.view">
        <field name="name">freight.sea.charge.table.list</field>
        <field name="model">freight.sea.charge.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="description"/>
                <field name="job_type_id"/>
                <field name="module_code"/>
                <field name="customer_id"/>
                <field name="valid"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_freight_sea_charge_table_form" model="ir.ui.view">
        <field name="name">freight.sea.charge.table.form</field>
        <field name="model">freight.sea.charge.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="job_type_id"/>
                            <field name="module_code"/>
                            <field name="estimated_transit_time"/>
                            <field name="frequency"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                            <field name="port_loading_id"/>
                            <field name="port_discharge_id"/>
                            <field name="via_port_id"/>
                            <field name="destination_city_id"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="valid"/>
                            <field name="standard_charge"/>
                            <field name="freight_collect"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="note_code"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="charge_code_id"/>
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="cargo_type"/>
                                    <field name="dg_level"/>
                                    <field name="uom_id"/>
                                    <field name="charge_flag"/>
                                    <field name="vat_id"/>
                                    <field name="prepaid_collect"/>
                                    <field name="charge_unit"/>
                                    <field name="container_type_id"/>
                                    <field name="rate_type"/>
                                    <field name="currency_id"/>
                                    <field name="minimum_amount"/>
                                    <field name="amount"/>
                                    <field name="cost"/>
                                    <field name="percent"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_sea_charge_table_search" model="ir.ui.view">
        <field name="name">freight.sea.charge.table.search</field>
        <field name="model">freight.sea.charge.table</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="description"/>
                <field name="job_type_id"/>
                <field name="customer_id"/>
                <filter name="filter_valid" string="Valid" domain="[('valid', '=', True)]"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_sea_charge_table" model="ir.actions.act_window">
        <field name="name">Charge Table</field>
        <field name="res_model">freight.sea.charge.table</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="view_freight_sea_charge_table_search"/>
    </record>
</odoo>
