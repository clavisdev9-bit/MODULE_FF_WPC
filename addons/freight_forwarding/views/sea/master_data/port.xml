<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_port_list" model="ir.ui.view">
        <field name="name">freight.port.list</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="view_freight_port_form" model="ir.ui.view">
        <field name="name">freight.port.form</field>
        <field name="model">freight.port</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="country_id"/>
                            <field name="via_port_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="dg_cargo"/>
                            <field name="symbol"/>
                            <field name="group_code"/>
                            <field name="region_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Destinations" name="destinations">
                            <field name="destination_ids">
                                <list editable="bottom">
                                    <field name="destination_city_id"/>
                                    <field name="no_of_day"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freight_port" model="ir.actions.act_window">
        <field name="name">Port</field>
        <field name="res_model">freight.port</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>