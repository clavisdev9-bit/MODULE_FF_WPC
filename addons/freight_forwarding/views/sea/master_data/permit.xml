<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_freight_permit_list" model="ir.ui.view">
        <field name="name">freight.permit.list</field>
        <field name="model">freight.permit</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_freight_permit_form" model="ir.ui.view">
        <field name="name">freight.permit.form</field>
        <field name="model">freight.permit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freight_permit_search" model="ir.ui.view">
        <field name="name">freight.permit.search</field>
        <field name="model">freight.permit</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_sea_permit" model="ir.actions.act_window">
        <field name="name">Permit</field>
        <field name="res_model">freight.permit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freight_permit_search"/>
    </record>
</odoo>
