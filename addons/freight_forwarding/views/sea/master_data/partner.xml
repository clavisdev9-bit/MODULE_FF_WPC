<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_city_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.city.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Main address format -->
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='city']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]/field[@name='city']" position="after">
                <field name="city_id" placeholder="City" class="o_address_city" domain="[('country_id', '=?', country_id), ('state_id', '=?', state_id)]" context="{'default_country_id': country_id, 'default_state_id': state_id}" options="{'no_open': True, 'no_create_edit': True}"/>
            </xpath>

            <!-- Child contacts address format -->
            <xpath expr="//field[@name='child_ids']/form//div[hasclass('o_address_format')]/field[@name='city']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//div[hasclass('o_address_format')]/field[@name='city']" position="after">
                <field name="city_id" placeholder="City" class="o_address_city" domain="[('country_id', '=?', country_id), ('state_id', '=?', state_id)]" context="{'default_country_id': country_id, 'default_state_id': state_id}" options="{'no_open': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
