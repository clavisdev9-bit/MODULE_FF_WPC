<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sea Booking Form View -->
        <record id="view_sea_booking_form" model="ir.ui.view">
            <field name="name">Sea Booking Form</field>
            <field name="model">freight.sea.booking</field>
            <field name="arch" type="xml">
                <form string="Sea Booking">
                    <header>
                        <button name="action_confirm" string="Confirm Booking" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_convert_to_hbl" type="object" string="Convert to Jobsheet" class="oe_highlight" invisible="hbl_count &gt; 0 or state != 'confirmed'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'confirmed')"/>
                        <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_view_sales_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="sales_order_count == 0">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Sales Orders</span>
                                </div>
                            </button>
                            <button name="action_view_hbl"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="hbl_count == 0">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Jobsheet</span>
                                </div>
                            </button>
                        </div>
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <group string="Header Information">
                            <group>
                                <field name="freight_type"/>
                                <field name="booking_date"/>
                                <field name="bl_no"/>
                                <field name="job_no"/>
                                <field name="nomination_cargo"/>
                                <field name="commodity_id"/>
                                <field name="shipment_type_id" />
                                <field name="delivery_type_id"/>
                            </group>
                            <group>
                                <field name="container_type"/>
                                <field name="job_date"/>
                                <field name="import_job_no"/>
                                <field name="railing"/>
                            </group>
                        </group>

                        <separator />

                        <group string="Customer &amp; Sales">
                            <group>
                                <field name="partner_id"/>
                                <field name="customer_reference"/>
                                <field name="phone"/>
                                <field name="email" widget="email"/>
                            </group>
                            <group>
                                <field name="payment_term_id"/>
                                <field name="salesman_id"/>
                            </group>
                        </group>

                        <separator />

                        <group string="Routing">
                            <group>
                                <field name="from_city"/>
                                <field name="to_city"/>
                            </group>
                            <group>
                                <field name="origin_country_id"/>
                                <field name="destination_country_id"/>
                            </group>
                        </group>

                        <separator />

                        <notebook>
                            <page string="B/L Info">
                                <group>
                                    <group string="Shipper">
                                        <field name="shipper_id" widget="res_partner_many2one"
                                            context="{'res_partner_search_mode': 'customer', 'show_address': 0}" />
                                        <field name="shipper_address" readonly="1" nolabel="0" />
                                    </group>
                                    <group string="Consignee">
                                        <field name="consignee_id" widget="res_partner_many2one"
                                            context="{'res_partner_search_mode': 'customer', 'show_address': 0}" />
                                        <field name="consignee_address" readonly="1" nolabel="0" />
                                    </group>
                                </group>
                                <group>
                                    <group string="Notify Party">
                                        <field name="notify_party_id" widget="res_partner_many2one"
                                            context="{'res_partner_search_mode': 'customer', 'show_address': 0}" />
                                        <field name="notify_party_address" readonly="1" nolabel="0" />
                                    </group>
                                    <group string="Delivery Agent">
                                        <field name="delivery_agent_id" widget="res_partner_many2one"
                                            context="{'res_partner_search_mode': 'customer', 'show_address': 0}" />
                                        <field name="delivery_agent_address" readonly="1" nolabel="0" />
                                    </group>
                                </group>
                            </page>
                            <page string="Shipment Info">
                                <group>
                                    <group>
                                        <field name="place_of_receipt_id" />
                                        <field name="place_of_delivery_id" />
                                        <field name="feeder_vessel_id" />
                                        <field name="feeder_voyage_no" />
                                        <field name="mother_vessel_id" />
                                        <field name="mother_voyage_no" />
                                    </group>
                                    <group>
                                        <field name="eta" />
                                        <field name="etd" />
                                        <field name="port_of_loading_id" string="Port of Loading" />
                                        <field name="port_of_discharge_id" string="Port of Discharge" />
                                        <field name="via_port_id" />
                                        <field name="terminal_id" />
                                        <field name="shipping_line_id" />
                                        <field name="shipping_line_ref_no" />
                                        <field name="coloader_id" />
                                        <field name="coloader_ref_no" />
                                    </group>
                                </group>
                            </page>

                            <!-- <page string="Agent &amp; Terms">
                                <group>
                                    <group>
                                        <field name="forward_agent_id" />
                                        <field name="letter_of_credit" />
                                    </group>
                                    <group>
                                        <field name="freight_terms" />
                                        <field name="other_charges_terms" />
                                        <field name="ship_mode" />
                                        <field name="service_level" />
                                    </group>
                                </group>
                            </page>
                            <page string="Vessel Schedule">
                                <group>
                                    <field name="vessel_schedule_id">
                                        <form>
                                            <group>
                                                <field name="vessel_id" />
                                                <field name="name" />
                                                <field name="voyage_no" />
                                                <field name="arrival" />
                                                <field name="berthing" />
                                                <field name="departure" />
                                                <field name="closing" />
                                                <field name="terminal_id" />
                                                <field name="status" />
                                                <field name="open_stack" />
                                            </group>
                                        </form>
                                    </field>
                                    <field name="etd_eta" />
                                    <field name="via_etd" />
                                    <field name="via_eta" />
                                </group>
                            </page>

                            <page string="Footer Remarks">
                                <group>
                                    <field name="booking_remark_id" />
                                    <field name="warehouse_remark" />
                                </group>
                            </page> -->

                            <page string="Vessel Details">
                                <group string="Booking &amp; Agent Information">
                                    <field name="principle_agent_id" />
                                    <field name="shipping_agent_id" />
                                    <field name="scn_code" />
                                </group>

                                <group string="Stuffing Warehouse &amp; SMK">
                                    <group>
                                        <field name="warehouse_id" />
                                        <field name="warehouse_address" />
                                    </group>
                                    <group>
                                        <field name="smk_code1" />
                                        <field name="smk_code2" />
                                    </group>
                                </group>

                                <group string="Scheduling &amp; Receipt Details">
                                    <group>
                                        <field name="close_date" />
                                        <field name="cargo_receipt_date" />
                                        <field name="stuffing_date" />
                                        <field name="contact_id" />
                                    </group>
                                </group>

                                <group string="Yard &amp; Depot Details">
                                    <group string="Yard Information">
                                        <field name="yard_id" />
                                        <field name="yard_code" />
                                        <field name="yard_address" />
                                    </group>
                                    <group string="Depot Information">
                                        <field name="depot_id" />
                                        <field name="depot_code" />
                                        <field name="depot_address" />
                                    </group>
                                    <field name="depot_instruction" />
                                </group>
                                
                                <group string="General Instructions">
                                    <field name="general_instruction" />
                                </group>
                            </page>
                            <page string="Cargo Info">
                                <field name="cargo_info_ids" nolabel="1" />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Sea Booking List View -->
        <record id="view_sea_booking_list" model="ir.ui.view">
            <field name="name">Sea Booking list</field>
            <field name="model">freight.sea.booking</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="sale_order_ids" widget="many2many_tags"/>
                    <field name="partner_id" />
                    <field name="container_type" />
                    <field name="freight_type" />
                    <field name="vessel_id" />
                    <field name="etd" />
                    <field name="eta" />
                </list>
            </field>
        </record>

        <!-- Sea Booking Search View -->
        <record id="view_sea_booking_search" model="ir.ui.view">
            <field name="name">Sea Booking Search</field>
            <field name="model">freight.sea.booking</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Booking No." />
                    <field name="partner_id" />
                    <field name="vessel_id" />
                    <field name="container_type" />
                    <field name="freight_type" />
                    <separator />
                    <filter name="filter_import" string="Import" domain="[('freight_type', '=', 'import')]" />
                    <filter name="filter_export" string="Export" domain="[('freight_type', '=', 'export')]" />
                    <filter name="filter_fc" string="Full Container"
                        domain="[('container_type', '=', 'fcl')]" />
                    <filter name="filter_lc" string="Less Than Container"
                        domain="[('container_type', 'in', ['lcl', 'consol'])]" />
                    <filter name="filter_fcl" string="FCL" domain="[('container_type', '=', 'fcl')]" />
                    <filter name="filter_lcl" string="LCL" domain="[('container_type', '=', 'lcl')]" />
                    <filter name="filter_consol" string="Consol"
                        domain="[('container_type', '=', 'consol')]" />
                </search>
            </field>
        </record>

        <!-- Sea Booking Action -->
        <record id="action_sea_booking" model="ir.actions.act_window">
            <field name="name">Sea Booking</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="context">{"search_default_type": "Import"}</field>
        </record>

        <record id="action_sea_booking_import_fcl" model="ir.actions.act_window">
            <field name="name">Import FCL Shipment</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'import'), ('container_type', '=', 'fcl')]</field>
        </record>

        <record id="action_sea_booking_import_lcl" model="ir.actions.act_window">
            <field name="name">Import LCL Shipment</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'import'), ('container_type', '=', 'lcl')]</field>
        </record>

        <record id="action_sea_booking_import_consol" model="ir.actions.act_window">
            <field name="name">Import Consol Shipment</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'import'), ('container_type', '=', 'consol')]</field>
        </record>

        <record id="action_sea_booking_export_fcl" model="ir.actions.act_window">
            <field name="name">Export FCL Booking</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'export'), ('container_type', '=', 'fcl')]</field>
        </record>

        <record id="action_sea_booking_export_lcl" model="ir.actions.act_window">
            <field name="name">Export LCL Booking</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'export'), ('container_type', '=', 'lcl')]</field>
        </record>

        <record id="action_sea_booking_export_consol" model="ir.actions.act_window">
            <field name="name">Export Consol Booking</field>
            <field name="res_model">freight.sea.booking</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sea_booking_search" />
            <field name="domain">[('freight_type', '=', 'export'), ('container_type', '=', 'consol')]</field>
        </record>

    </data>
</odoo>