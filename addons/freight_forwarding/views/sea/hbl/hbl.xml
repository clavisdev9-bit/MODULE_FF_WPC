<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sea_hbl_list" model="ir.ui.view">
        <field name="name">freight.sea.job.list</field>
        <field name="model">freight.sea.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="job_no" />
                <field name="record_level" widget="badge" decoration-success="record_level == 'master'" decoration-info="record_level == 'house'" />
                <field name="master_job_id" string="Master Job No." />
                <field name="bl_no" />
                <field name="freight_type" />
                <field name="ship_mode" />
                <field name="sale_order_ids" widget="many2many_tags" />
                <field name="booking_id" />
                <field name="customer_id" />
                <field name="job_date" />
            </list>
        </field>
    </record>

    <record id="view_sea_hbl_form" model="ir.ui.view">
        <field name="name">freight.sea.job.form</field>
        <field name="model">freight.sea.job</field>
        <field name="arch" type="xml">
            <form string="Sea Jobsheet">
                <header>
                    <button name="action_active" string="Mark as Active" type="object"
                        class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_close" string="Close Jobsheet" type="object"
                        class="oe_highlight" invisible="state != 'active'" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('cancelled', 'closed')" />
                    <button name="action_draft" string="Set to Draft" type="object"
                        invisible="state == 'draft'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,active,closed,cancelled" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_sales_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="sales_order_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sales Orders</span>
                            </div>
                        </button>
                        <button name="action_view_booking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-ship"
                            invisible="booking_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Booking</span>
                            </div>
                        </button>
                    </div>
                    <h1>
                        <field name="job_no" readonly="1" />
                    </h1>
                    <group string="Header Information">
                        <group>
                            <field name="record_level" widget="radio" options="{'horizontal': true}" />
                            <field name="master_job_id" string="Master Job No." invisible="record_level != 'house'" />
                            <field name="freight_type" />
                            <field name="ship_mode" />
                            <field name="job_type_id"
                                domain="[('business_type', '=', 'sea'), ('freight_type', '=', freight_type), ('sea_ship_mode', '=', ship_mode)]" />
                            <field name="booking_id" invisible="record_level == 'house'" />
                            <field name="job_date" />
                            <field name="job_city_id" />
                        </group>
                        <group>
                            <!-- FF-76 Step 2 (corrective): document_id
                                 adalah SATU-SATUNYA cara user mengisi/
                                 mengubah B/L. bl_no sekarang derived
                                 read-only alias (compatibility display,
                                 disembunyikan dari form ini), bukan entry
                                 point lagi. Manual UAT: berbeda dari Air,
                                 di mana Master Air existing-only, Sea Master
                                 JUGA boleh create/quick-create B/L baru,
                                 sama seperti House. Jadi dirender dengan
                                 satu domain/context yang sama untuk kedua
                                 record_level, tanpa no_create/no_quick_create. -->
                            <field name="document_id"
                                string="B/L No."
                                invisible="record_level not in ('house', 'master')"
                                domain="[('transport_mode', '=', 'sea'), '|', ('is_available', '=', True), ('id', '=', document_id)]"
                                context="{'default_transport_mode': 'sea'}" />
                            <field name="bl_no" invisible="1" />
                            <field name="obl_no" />
                            <field name="original_bl_no" />
                            <field name="no_of_original_bl" />
                            <field name="bl_surrendered" />
                            <field name="commodity_id" />
                            <field name="delivery_type_id" />
                        </group>
                    </group>

                    <group string="Customer &amp; Sales">
                        <group>
                            <field name="customer_id" />
                            <field name="customer_ref" />
                            <field name="shipper_id" />
                            <field name="shipper_address" readonly="1" />
                            <field name="actual_shipper" />
                            <field name="do_ready_on" />
                        </group>
                        <group>
                            <field name="consignee_id" />
                            <field name="consignee_address" readonly="1" />
                            <field name="term_payment" />
                            <field name="salesperson_id" invisible="record_level != 'house'" />
                            <!-- <field name="export_sales_team_id"/> -->
                            <field name="analytic_account_id" readonly="1" />
                        </group>
                    </group>

                    <group>
                        <group string="Notify Party">
                            <!-- <field name="notify_same_as_consignee" />
                            <field name="notify_party_id" /> -->
                            <label for="notify_party_id" string="Notify Party"/>
                            <div class="o_row">
                                <field name="notify_party_id" />
                                <button name="action_same_as_consignee" string="Same As Consignee"
                                    type="object" class="btn-link" />
                            </div>
                            <field name="notify_address" readonly="1" />
                        </group>
                        <group string="Delivery &amp; Freight">
                            <field name="delivery_agent_id" />
                            <field name="delivery_agent_address" readonly="1" />
                            <field name="freight" />
                            <field name="freight_terms" />
                            <field name="remark" />
                        </group>
                    </group>

                    <group string="Route">
                        <group>
                            <field name="from_city" />
                            <field name="origin_country_id" />
                        </group>
                        <group>
                            <field name="to_city" />
                            <field name="destination_country_id" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Shipment Info">
                            <group>
                                <group>
                                    <field name="place_of_receipt_id" />
                                    <field name="place_of_delivery_id" />
                                    <field name="port_of_loading_id" />
                                    <field name="port_of_discharge_id" />
                                </group>
                                <group>
                                    <field name="eta_jkt" />
                                    <field name="etd" />
                                    <field name="eta" />
                                    <field name="via_port_id" />
                                    <field name="terminal_id" />
                                </group>
                            </group>

                            <separator />

                            <group>
                                <group>
                                    <field name="feeder_vessel_id" />
                                    <field name="feeder_voyage_no" />
                                    <field name="mother_vessel_id" />
                                    <field name="mother_voyage_no" />
                                </group>
                                <group>
                                    <field name="shipping_line_id" />
                                    <field name="shipping_line_ref_no" />
                                    <field name="coloader_id" />
                                    <field name="coloader_ref_no" />
                                </group>
                            </group>
                        </page>

                        <!-- <page string="Footer Remarks">
                            <group>
                                <field name="booking_remark_id" />
                                <field name="warehouse_remark" />
                            </group>
                        </page> -->

                        <page string="Vessel Details">
                            <group string="Stuffing Warehouse &amp; SMK"
                                invisible="freight_type == 'import'">
                                <group>
                                    <field name="warehouse_id" />
                                    <field name="warehouse_address" />
                                </group>
                                <group>
                                    <field name="smk_code1" />
                                    <field name="smk_code2" />
                                </group>
                            </group>

                            <group string="Warehouse &amp; SMK" invisible="freight_type != 'import'">
                                <group>
                                    <field name="warehouse_id" />
                                    <field name="warehouse_address" />
                                    <field name="pbm" />
                                </group>
                                <group>
                                    <field name="smk_code1" />
                                    <field name="smk_code2" />
                                </group>
                            </group>

                            <group string="Scheduling &amp; Receipt Details">
                                <group>
                                    <field name="close_date" />
                                    <field name="cargo_receipt_date" />
                                    <field name="stuffing_date" />
                                    <field name="contact_id" />
                                </group>
                            </group>

                            <group string="Yard &amp; Depot Details">
                                <group string="Yard Information">
                                    <field name="yard_id" />
                                    <field name="yard_code" />
                                    <field name="yard_address" />
                                </group>
                                <group string="Depot Information">
                                    <field name="depot_id" />
                                    <field name="depot_code" />
                                    <field name="depot_address" />
                                </group>
                            </group>
                        </page>
                        <page string="Cargo Info">
                            <field name="cargo_info_ids" />
                        </page>
                        <page string="Custom Permit">
                            <field name="custom_permit_ids" nolabel="1">
                                <list>
                                    <field name="no_document" />
                                    <field name="date" />
                                    <field name="status" />
                                </list>
                            </field>
                        </page>
                        <page string="Purchase Order">
                            <field name="purchase_order_ids" nolabel="1"
                                context="{'default_sea_job_id': id}">
                                <list editable="bottom" open_form_view="1">
                                    <field name="name" />
                                    <field name="partner_id" />
                                    <field name="currency_id" />
                                    <field name="amount_total" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Sales Orders">
                            <!-- FF-73: sale_order_ids sekarang cuma compatibility mirror dari
                                 commercial group (source_quotation_id + variant_ids); currency
                                 variant baru otomatis ikut tersinkron (lihat action_create_currency_variant),
                                 jadi tab ini display-only, bukan lagi jalur manual-add. -->
                            <field name="sale_order_ids" nolabel="1" readonly="1"
                                context="{'form_view_ref': 'freight_forwarding.view_sea_quotation_form', 'default_is_freight_quotation': True, 'default_freight_business_type': 'sea', 'default_freight_type': 'import', 'default_sea_job_id': id}">
                                <list editable="bottom" open_form_view="1">
                                    <field name="name" />
                                    <field name="currency_id" />
                                    <field name="amount_total" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Tax Refund Doc">
                            <field name="tax_refund_doc_ids" nolabel="1" />
                        </page>
                        <page string="House Jobs" invisible="record_level != 'master'">
                            <field name="house_job_ids" nolabel="1">
                                <list>
                                    <field name="job_no" />
                                    <field name="bl_no" />
                                    <field name="customer_id" />
                                    <field name="source_quotation_id" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Document List">
                            <notebook>
                                <page string="Invoice">
                                    <field name="invoice_ids" nolabel="1" />
                                </page>
                                <page string="Debit Note">
                                    <field name="debit_note_ids" nolabel="1" />
                                </page>
                                <page string="Credit Note">
                                    <field name="credit_note_ids" nolabel="1" />
                                </page>
                                <page string="Provision Cost">
                                    <field name="provision_cost_ids" nolabel="1" />
                                </page>
                                <page string="Vendor Invoice">
                                    <field name="vendor_invoice_ids" nolabel="1" />
                                </page>
                                <page string="Vendor Debit Note">
                                    <field name="vendor_debit_note_ids" nolabel="1" />
                                </page>
                                <page string="Vendor Credit Note">
                                    <field name="vendor_credit_note_ids" nolabel="1" />
                                </page>
                                <page string="Cash Purchase">
                                    <field name="cash_purchase_ids" nolabel="1" />
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_sea_hbl_search" model="ir.ui.view">
        <field name="name">freight.sea.job.search</field>
        <field name="model">freight.sea.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_no" />
                <field name="bl_no" />
                <field name="booking_id" />
                <field name="customer_id" />
                <field name="freight_type" />
                <field name="ship_mode" />
                <separator />
                <filter name="filter_import" string="Import"
                    domain="[('freight_type', '=', 'import')]" />
                <filter name="filter_export" string="Export"
                    domain="[('freight_type', '=', 'export')]" />
                <filter name="filter_fcl" string="FCL" domain="[('ship_mode', '=', 'fcl')]" />
                <filter name="filter_lcl" string="LCL" domain="[('ship_mode', '=', 'lcl')]" />
                <separator />
                <filter name="filter_master" string="Master"
                    domain="[('record_level', '=', 'master')]" />
                <filter name="filter_house" string="House"
                    domain="[('record_level', '=', 'house')]" />
            </search>
        </field>
    </record>

    <record id="action_sea_hbl" model="ir.actions.act_window">
        <field name="name">Sea Jobsheet</field>
        <field name="res_model">freight.sea.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_hbl_search" />
    </record>

    <record id="action_sea_hbl_import_fcl" model="ir.actions.act_window">
        <field name="name">Import Jobsheet FCL</field>
        <field name="res_model">freight.sea.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_hbl_search" />
        <field name="domain">[('freight_type', '=', 'import'), ('ship_mode', '=', 'fcl')]</field>
    </record>

    <record id="action_sea_hbl_import_lcl" model="ir.actions.act_window">
        <field name="name">Import Jobsheet LCL</field>
        <field name="res_model">freight.sea.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_hbl_search" />
        <field name="domain">[('freight_type', '=', 'import'), ('ship_mode', '=', 'lcl')]</field>
    </record>

    <record id="action_sea_hbl_export_fcl" model="ir.actions.act_window">
        <field name="name">Export Jobsheet FCL</field>
        <field name="res_model">freight.sea.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_hbl_search" />
        <field name="domain">[('freight_type', '=', 'export'), ('ship_mode', '=', 'fcl')]</field>
    </record>

    <record id="action_sea_hbl_export_lcl" model="ir.actions.act_window">
        <field name="name">Export Jobsheet LCL</field>
        <field name="res_model">freight.sea.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sea_hbl_search" />
        <field name="domain">[('freight_type', '=', 'export'), ('ship_mode', '=', 'lcl')]</field>
    </record>

</odoo>