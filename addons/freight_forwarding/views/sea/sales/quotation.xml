        </field>
    </record>

    <record id="view_sea_quotation_list_custom" model="ir.ui.view">
        <field name="name">freight.sea.quotation.list.custom</field>
        <field name="model">sale.order</field>
        <!-- Hapus mode dan inherit_id -->
        <field name="arch" type="xml">
            <list>
                <!-- Masukkan field sesuai urutan yang Anda mau -->
                <field name="name" string="Number" decoration-bf="1" />
                <field name="create_date" string="Creation Date" />
                <field name="freight_type" string="Quotation Type" />
                <field name="container_type" string="Container Type" />
                <field name="partner_id" string="Customer" />
                <field name="user_id" string="Salesperson" />
                <field name="amount_total" string="Total" />
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'sale'"/>
            </list>
        </field>
    </record>

    <record id="view_sea_quotation_search" model="ir.ui.view">
        <field name="name">freight.sea.quotation.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Sea Quotation">
                <field name="name" string="Quotation Number"/>
                <field name="partner_id"/>
                <field name="user_id" string="Salesperson"/>
                <field name="team_id"/>
                <field name="state"/>
                <field name="freight_type"/>
                <field name="container_type"/>
                <separator/>
                <filter name="my_quotation" string="My Quotations" domain="[('user_id', '=', uid)]"/>
                <filter name="filter_draft_sent" string="Quotation" domain="[('state', 'in', ['draft', 'sent'])]"/>
                <filter name="filter_sale" string="Sales Order" domain="[('state', '=', 'sale')]"/>
                <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="action_freight_sea_quotation" model="ir.actions.act_window">
        <field name="name">Sea Quotation</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sea_quotation_list_custom"/>
        <field name="search_view_id" ref="view_sea_quotation_search"/>
        <field name="domain">[('freight_business_type', '=', 'sea'), ('is_freight_quotation', '=', True)]</field>
        <field name="context">{'search_default_my_quotation': 1, 'default_freight_business_type': 'sea', 'default_is_freight_quotation': True}</field>
    </record>

    <record id="action_freight_sea_quotation_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sea_quotation_list_custom"/>
        <field name="act_window_id" ref="action_freight_sea_quotation"/>
    </record>

    <record id="action_freight_sea_quotation_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sea_quotation_form"/>
        <field name="act_window_id" ref="action_freight_sea_quotation"/>
    </record>

    <!-- Action gear menu item: New Currency Variant -->
    <record id="action_server_create_currency_variant" model="ir.actions.server">
        <field name="name">New Currency Variant</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="sequence">1</field>
        <field name="state">code</field>
        <field name="code">action = record.action_create_currency_variant()</field>
    </record>

</odoo>