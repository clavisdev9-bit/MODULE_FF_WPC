<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cover_jobsheet_document">
        <t t-call="web.basic_layout">
            <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 24px;">
                <!-- Header -->
                <div style="text-align: center; margin-bottom: 30px;">
                    <h3 style="font-weight: bold; margin: 0; padding: 0;">PT. WINDU PERSADA CARGO</h3>
                    <h4 style="font-weight: bold; margin: 0; padding: 0;">ORDER SHEET</h4>
                    <h4 style="font-weight: bold; margin: 0; padding: 0;">
                        <t t-if="o.freight_type == 'export'">SEA EXPORT</t>
                        <t t-else="">SEA IMPORT</t>
                    </h4>
                </div>

                <!-- Info Table -->
                <table style="width: 100%; border-collapse: collapse; border: 0;">
                    <tbody>
                        <tr>
                            <td style="width: 20%; padding-bottom: 3px;">JO NO.</td>
                            <td style="width: 3%; padding-bottom: 3px;">:</td>
                            <td style="width: 47%; padding-bottom: 3px;" class="fw-bold"><span t-field="o.job_no"/></td>
                            <td style="width: 10%;"></td>
                            <td style="width: 3%;"></td>
                            <td style="width: 17%;"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">CONSIGNEE</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.consignee_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">CUSTOMER</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.customer_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">SHIPPER</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.shipper_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">AGENT</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;">[AGENT PLACEHOLDER]</td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">CARRIER</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;">[CARRIER PLACEHOLDER]</td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">WAREHOUSE</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.warehouse_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td colspan="6" style="height: 15px;"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">MB/L NO.</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.mbl_no"/></td>
                            <td style="padding-bottom: 3px;">ETA</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.eta" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">HB/L NO.</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.hbl_no"/></td>
                            <td style="padding-bottom: 3px;">ETD</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.etd" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">POD</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.port_of_discharge_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">POL</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.port_of_loading_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">VIA</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.via_port_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">QTY</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;">
                                <t t-set="total_qty" t-value="sum(c.quantity for c in o.cargo_info_ids)"/>
                                <t t-esc="total_qty"/> CASES
                            </td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">VESSEL</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.feeder_vessel_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">VOYAGE NO</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.feeder_voyage_no"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">MOTHER VESSEL</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.mother_vessel_id.name"/></td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">CONTAINER</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;">
                                <t t-foreach="o.cargo_info_ids" t-as="cargo">
                                    <span t-field="cargo.container_no"/>/<span t-field="cargo.seal_no"/><t t-if="not cargo_last">, </t>
                                </t>
                            </td>
                            <td colspan="3"></td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 3px;">REMARK</td>
                            <td style="padding-bottom: 3px;">:</td>
                            <td style="padding-bottom: 3px;"><span t-field="o.general_instruction"/></td>
                            <td colspan="3"></td>
                        </tr>
                    </tbody>
                </table>

                <div style="page-break-after: always;"/>

                <!-- Page 2 (Checklist) -->
                <div style="text-align: center; margin-bottom: 30px; margin-top: 30px;">
                    <h3 style="font-weight: bold; margin: 0; padding: 0;">PT. WINDU PERSADA CARGO</h3>
                    <h4 style="font-weight: bold; margin: 0; padding: 0;">ORDER SHEET</h4>
                    <h4 style="font-weight: bold; margin: 0; padding: 0;">
                        <t t-if="o.freight_type == 'export'">SEA EXPORT</t>
                        <t t-else="">SEA IMPORT</t>
                    </h4>
                </div>
                
                <table style="width: 100%; border: 0; margin-top: 50px;">
                    <tr>
                        <td style="width: 50%; vertical-align: top;">
                            <table class="table table-borderless table-sm">
                                <tbody>
                                    <tr>
                                        <td style="width: 40px;"><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>PRE ALERT</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>MANIFEST ADJUSTMENT</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>DRAFT PIB</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>PIB CONFIRMED</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>PIB PAYMENT</td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <div class="mt-4 ms-2">
                                <div class="mb-2">CUSTOMS DOCS</div>
                                <div style="font-size: 16px;">
                                    * HB/L COPY NON NEGOTIABLE, MBL, MANIFEST<br/>
                                    * S. PERNYATAAN TELEX RELEASE FRM F/F<br/>
                                    * S.PERNYATAAN KEABSAHAN DOC (B/L)<br/>
                                    * PIB ASLI<br/>
                                    * SSPCP, BPN<br/>
                                    * BUKTI SETORAN BANK<br/>
                                    * D/O ASLI<br/>
                                    * CIPL ASLI
                                </div>
                            </div>
                        </td>
                        <td style="width: 50%; vertical-align: top;">
                            <table class="table table-borderless table-sm">
                                <tbody>
                                    <tr>
                                        <td style="width: 40px;"><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>DELIVERY / PU DATE</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>SPPB</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>SEND PROOF OF DLVRY</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>COLLECT D/O</td>
                                    </tr>
                                    <tr>
                                        <td><div style="width: 25px; height: 25px; border: 1px solid black;"></div></td>
                                        <td>OTHERS :</td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
                
            </div>
        </t>
    </template>

    <template id="report_cover_jobsheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="freight_forwarding.report_cover_jobsheet_document" t-lang="o.env.user.lang"/>
            </t>
        </t>
    </template>
</odoo>
