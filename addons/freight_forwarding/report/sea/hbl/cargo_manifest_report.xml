<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cargo_manifest_paperformat" model="report.paperformat">
        <field name="name">Cargo Manifest A4 Landscape</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">9</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="cargo_manifest_report" model="ir.actions.report">
        <field name="name">Cargo Manifest</field>
        <field name="model">freight.sea.hbl</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">freight_forwarding.cargo_manifest_report_template</field>
        <field name="report_file">freight_forwarding.cargo_manifest_report_template</field>
        <field name="print_report_name">'Cargo Manifest'</field>
        <field name="paperformat_id" ref="cargo_manifest_paperformat"/>
        <field name="binding_model_id" ref="freight_forwarding.model_freight_sea_hbl"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>