<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="shipping_instruction_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="doc.env.company"/>
                    <t t-set="si_shipper" t-value="doc.shipper_id if doc.actual_shipper else doc.env.company.partner_id"/>
                    <t t-set="si_consignee" t-value="doc.consignee_id if doc.actual_shipper else doc.delivery_agent_id"/>

                    <div class="header" style="padding-top: 10px; padding-bottom: 6px;">
                        <style>
                            * { box-sizing: border-box; }
                            .si-header-company { font-size: 15pt; font-weight: bold; color: #333; font-family: Arial, Helvetica, sans-serif; }
                            .si-header-sub { font-size: 10pt; font-weight: 500; line-height: 1.3; color: #333; font-family: Arial, Helvetica, sans-serif; }
                        </style>
                        <table style="width:100%; border-collapse: collapse; border: none !important; margin-bottom: 3px;">
                            <tr>
                                <td style="border:none !important; width: 90px; padding-right: 0px; vertical-align: top;">
                                    <img t-if="company and company.logo" t-att-src="image_data_uri(company.logo)"
                                        style="height: 100px; width: auto; display: block;" />
                                </td>
                                <td style="border:none !important; vertical-align: top; padding-top: 4px;">
                                    <div class="si-header-company"><t t-esc="company.name"/></div>
                                    <div class="si-header-sub">
                                        <t t-esc="company.street"/><t t-if="company.street2">, <t t-esc="company.street2"/></t><t t-if="company.city">, <t t-esc="company.city"/></t><t t-if="company.zip"> <t t-esc="company.zip"/></t>
                                    </div>
                                    <div class="si-header-sub">
                                        <t t-if="company.phone">Telp : <t t-esc="company.phone"/></t><t t-if="company.website">, Homepage: <t t-esc="company.website"/></t>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="footer">
                        <div style="text-align:center; font-size:7pt; font-family: Arial, Helvetica, sans-serif; color:#555; border-top: 1px solid #ccc; padding-top: 2px;">
                            Page <span class="page"/> of <span class="topage"/>
                        </div>
                    </div>

                    <div class="page">
                        <style>
                            * { box-sizing: border-box; }
                            @page { margin-bottom: 14mm; }
                            @page :first { margin-bottom: 14mm; }
                            .page { font-size: 9pt; color: #222; padding-bottom: 6px; }
                            .page span { font-size: inherit; }
                            .container-fluid { width: 100%; }

                            .table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                            .table tbody tr { page-break-inside: avoid; break-inside: avoid; }
                            .table td, .table th {
                                font-size: 9pt !important;
                                padding: 4px 6px !important;
                                vertical-align: top !important;
                                line-height: 1.25;
                                border: 1px solid #000;
                                word-wrap: break-word;
                                overflow-wrap: break-word;
                                word-break: break-word;
                            }

                            .si-label { font-weight: bold; font-size: 9pt; margin-bottom: 1px; color: #333; }
                            .si-title { text-align: center; font-weight: bold; font-size: 11pt; margin: 0; color: #333; }
                            .si-inline { display: table; width: 100%; }
                            .si-inline-row { display: table-row; line-height: 1.15; }
                            .si-inline-label { display: table-cell; font-weight: bold; white-space: nowrap; padding-bottom: 1px; padding-right: 5px; color: #333; }
                            .si-inline-colon { display: table-cell; width: 10px; }
                            .si-inline-value { display: table-cell; }

                            .si-total-row td {
                                font-weight: bold;
                                background-color: #f2f2f2;
                                border-top: 1px solid #000 !important;
                                border-bottom: 1px solid #000 !important;
                                padding-top: 5px !important;
                                padding-bottom: 5px !important;
                            }
                            .si-total-label {
                                font-size: 10pt;
                                letter-spacing: 0.5px;
                                color: #000;
                            }
                            .si-total-value {
                                font-size: 10pt;
                                color: #000;
                            }
                            .si-total-unit {
                                font-weight: normal;
                                font-size: 8pt;
                                color: #555;
                            }
                            .si-total-breakdown {
                                font-weight: normal;
                                font-size: 8pt;
                                color: #444;
                                line-height: 1.3;
                            }
                            .si-total-divider {
                                border-top: 1px solid #999;
                                margin: 2px 0;
                            }

                            strong { color: #333; }

                            .text-center { text-align: center; }
                            .mb-0 { margin-bottom: 0; }
                            .mt-0 { margin-top: 0; }
                        </style>

                        <div class="container-fluid">

                            <div class="si-title">SHIPPING INSTRUCTION</div>

                            <!-- Row 0: Empty spacer row -->
                            <table class="table mb-0">
                                <tr>
                                    <td colspan="2" style="padding: 1px 6px !important; line-height: 1;">&#160;</td>
                                </tr>
                            </table>

                            <!-- Row 1: Shipper (left) | Date/To/Attn/TEL/FAX/Booking No./Job No./STAFF (right) -->
                            <table class="table mb-0 mt-0">
                                <tr>
                                    <td style="width:55%; border-top: none;">
                                        <div class="si-label">Shipper</div>
                                        <div>
                                            <span t-field="si_shipper.name" /><br />
                                            <!-- PART C: full address (street, street2, city, state, zip, country) -->
                                            <span t-field="si_shipper.street" />
                                            <t t-if="si_shipper.street2">, <span t-field="si_shipper.street2" /></t>
                                            <t t-if="si_shipper.city">, <span t-field="si_shipper.city" /></t>
                                            <t t-if="si_shipper.state_id">, <span t-field="si_shipper.state_id.name" /></t>
                                            <t t-if="si_shipper.zip"> <span t-field="si_shipper.zip" /></t>
                                            <t t-if="si_shipper.country_id">, <span t-field="si_shipper.country_id.name" /></t>
                                            <br />
                                            <span t-field="si_shipper.phone" />
                                        </div>
                                    </td>
                                    <td style="width:45%; border-left: 1px solid #000; border-top: none; vertical-align: top;" rowspan="3">
                                        <div class="si-inline">
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Date</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.booking_id.booking_date"
                                                        t-options="{'widget': 'date'}" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">To</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.shipping_line_id.name" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Attn</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">&#160;</div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">TEL</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.shipping_line_id.phone" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">FAX</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">&#160;</div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Booking No.</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.booking_id.name" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Job No.</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.job_no" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">STAFF</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-esc="doc.env.user.name" />
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 2: Consignee -->
                                <tr>
                                    <td style="width:55%;">
                                        <div class="si-label">Consignee</div>
                                        <div>
                                            <span t-field="si_consignee.name" /><br />
                                            <!-- PART C: full address -->
                                            <span t-field="si_consignee.street" />
                                            <t t-if="si_consignee.street2">, <span t-field="si_consignee.street2" /></t>
                                            <t t-if="si_consignee.city">, <span t-field="si_consignee.city" /></t>
                                            <t t-if="si_consignee.state_id">, <span t-field="si_consignee.state_id.name" /></t>
                                            <t t-if="si_consignee.zip"> <span t-field="si_consignee.zip" /></t>
                                            <t t-if="si_consignee.country_id">, <span t-field="si_consignee.country_id.name" /></t>
                                            <br />
                                            <span t-field="si_consignee.phone" />
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 3: Notify Party -->
                                <tr>
                                    <td style="width:55%;">
                                        <div class="si-label">Notify Party</div>
                                        <div>
                                            <t t-set="same_notify" t-value="doc.notify_party_id and doc.notify_party_id == doc.consignee_id" />
                                            <t t-if="same_notify">
                                                <strong>SAME AS CONSIGNEE</strong>
                                            </t>
                                            <t t-else="">
                                                <span t-field="doc.notify_party_id.name" /><br />
                                                <!-- PART C: full address -->
                                                <span t-field="doc.notify_party_id.street" />
                                                <t t-if="doc.notify_party_id.street2">, <span t-field="doc.notify_party_id.street2" /></t>
                                                <t t-if="doc.notify_party_id.city">, <span t-field="doc.notify_party_id.city" /></t>
                                                <t t-if="doc.notify_party_id.state_id">, <span t-field="doc.notify_party_id.state_id.name" /></t>
                                                <t t-if="doc.notify_party_id.zip"> <span t-field="doc.notify_party_id.zip" /></t>
                                                <t t-if="doc.notify_party_id.country_id">, <span t-field="doc.notify_party_id.country_id.name" /></t>
                                                <br />
                                                <span t-field="doc.notify_party_id.phone" />
                                            </t>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 4: Feeder Vessel | Place of Receipt -->
                                <tr>
                                    <td>
                                        <div class="si-label">Feeder Vessel</div>
                                        <div><span t-field="doc.feeder_vessel_id.name" /></div>
                                    </td>
                                    <td>
                                        <div class="si-label">Place of Receipt</div>
                                        <div><span t-field="doc.place_of_receipt_id.name" /></div>
                                    </td>
                                </tr>

                                <!-- Row 5: Mother Vessel | Port of Loading -->
                                <tr>
                                    <td>
                                        <div class="si-label">Mother Vessel</div>
                                        <div><span t-field="doc.mother_vessel_id.name" /></div>
                                    </td>
                                    <td>
                                        <div class="si-label">Port of Loading</div>
                                        <div><span t-field="doc.port_of_loading_id.name" /></div>
                                    </td>
                                </tr>

                                <!-- Row 6: Port of Discharge | Place of Delivery | No. of Original B/L -->
                                <tr>
                                    <td style="border-bottom: none;">
                                        <div class="si-label">Port of Discharge</div>
                                        <div><span t-field="doc.port_of_discharge_id.name" /></div>
                                    </td>
                                    <td style="padding:0 !important; border-bottom: none;">
                                        <table style="width:100%; border-collapse:collapse; table-layout: fixed;">
                                            <tr>
                                                <td style="width:55%; padding:4px 6px !important; border:none;">
                                                    <div class="si-label">Place of Delivery</div>
                                                    <div><span t-field="doc.place_of_delivery_id.name" /></div>
                                                </td>
                                                <td style="width:45%; padding:4px 6px !important; border:none; border-left: 1px solid #000;">
                                                    <div class="si-label" style="white-space: nowrap;">No. of Original B/L</div>
                                                    <div><span t-field="doc.no_of_original_bl" /></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- PART A: pre-compute totals for the cargo table footer -->
                            <t t-set="package_totals" t-value="{}"/>
                            <t t-foreach="doc.cargo_info_ids" t-as="_cargo_for_total">
                                <t t-set="_pt_name" t-value="_cargo_for_total.package_type_id.name or ''"/>
                                <t t-set="package_totals" t-value="package_totals.update({_pt_name: package_totals.get(_pt_name, 0) + _cargo_for_total.quantity}) or package_totals"/>
                            </t>
                            <t t-set="total_quantity" t-value="sum(doc.cargo_info_ids.mapped('quantity'))"/>
                            <t t-set="total_gross_weight" t-value="sum(doc.cargo_info_ids.mapped('gross_weight'))"/>
                            <t t-set="total_measurement" t-value="sum(doc.cargo_info_ids.mapped('total_volume')) + sum(doc.cargo_info_ids.mapped('volume'))"/>

                            <table class="table mb-0 mt-0">
                                <thead>
                                    <tr>
                                        <td style="width:20%; border-top: 1px solid #000; border-bottom: none; border-right: none;"><div class="si-label">Container / Seal<br /><span style="white-space: nowrap;">No. Marks &amp; Nos.</span></div></td>
                                        <td style="width:20%; border-top: 1px solid #000; border-bottom: none; border-left: none; border-right: none;"><div class="si-label">No. and Kind of Package</div></td>
                                        <td style="width:45%; border-top: 1px solid #000; border-bottom: none; border-left: none; border-right: none;"><div class="si-label">Description of Goods</div></td>
                                        <td style="width:25%; border-top: 1px solid #000; border-bottom: none; border-left: none;"><div class="si-label" style="padding-left: 8px;">Weight<br />Measurement</div></td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.cargo_info_ids" t-as="cargo">
                                        <tr style="page-break-inside: avoid; break-inside: avoid;">
                                            <td style="width:20%; border-top: none; border-bottom: none; border-right: none;">
                                                <span t-field="cargo.container_no" /><br />
                                                <span t-if="cargo.seal_no" t-field="cargo.seal_no" /><br />
                                                <span t-if="cargo.marks_and_no" t-field="cargo.marks_and_no" />
                                            </td>
                                            <td style="width:20%; border-top: none; border-bottom: none; border-left: none; border-right: none;">
                                                <span t-field="cargo.quantity" />
                                                <span t-field="cargo.package_type_id.name" />
                                            </td>
                                            <td style="width:45%; border-top: none; border-bottom: none; border-left: none; border-right: none;">
                                                <span t-field="cargo.description_of_goods" />
                                            </td>
                                            <td style="width:25%; border-top: none; border-bottom: none; border-left: none; padding-left: 12px !important;">
                                                <span t-field="cargo.gross_weight" /> KGS<br />
                                                <span t-if="cargo.total_volume" t-field="cargo.total_volume" />
                                                <span t-elif="cargo.volume" t-field="cargo.volume" /> CBM
                                            </td>
                                        </tr>
                                    </t>

                                    <!-- PART A: TOTAL row -->
                                    <tr class="si-total-row" style="page-break-inside: avoid; break-inside: avoid;">
                                        <td style="width:20%; border-left: 1px solid #000; border-right: none; vertical-align: middle !important;">
                                            <span class="si-total-label">TOTAL</span>
                                        </td>
                                        <td style="width:20%; border-left: none; border-right: none; vertical-align: middle !important;">
                                            <t t-if="len(package_totals) > 1">
                                                <div class="si-total-breakdown">
                                                    <t t-foreach="package_totals.items()" t-as="pt_item">
                                                        <span style="font-weight: bold; color: #000; font-size: 10pt !important;" t-esc="pt_item[1]" t-options="{'widget': 'float', 'precision': 0}" /> <span style="font-size: 10pt !important; color: #555;" t-esc="pt_item[0]" /><br />
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <span class="si-total-value"><span t-esc="total_quantity" t-options="{'widget': 'float', 'precision': 0}" /></span>
                                                <span class="si-total-unit"> <span t-esc="list(package_totals.keys())[0] if package_totals else ''" /></span>
                                            </t>
                                        </td>
                                        <td style="width:45%; border-left: none; border-right: none;">&#160;</td>
                                        <td style="width:25%; border-left: none; border-right: 1px solid #000; padding-left: 12px !important; vertical-align: middle !important;">
                                            <span class="si-total-value"><span t-esc="total_gross_weight" t-options="{'widget': 'float', 'precision': 1}" /></span>
                                            <span class="si-total-unit"> KGS</span><br />
                                            <span class="si-total-value"><span t-esc="total_measurement" t-options="{'widget': 'float', 'precision': 1}" /></span>
                                            <span class="si-total-unit"> CBM</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td colspan="4" class="text-center" style="border-top: hidden !important; border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: none; vertical-align: middle !important; padding: 24px 6px 8px 6px !important; line-height: 1.2 !important;">
                                            SHIPPED ON BOARD DATED: 
                                            <span t-field="doc.booking_id.booking_date"
                                                t-options="{'widget': 'date'}" />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="4" style="border-left: 1px solid #000; border-right: 1px solid #000; border-top: none; border-bottom: 1px solid #000; padding: 0; height: 3mm; line-height: 3mm; font-size: 1px;">&#160;</td>
                                    </tr>
                                </tfoot>

                            </table>

                            <!-- Total number of packages -->
                            <div style="width: 100%; border: 1px solid #000; border-top: none; box-sizing: border-box; padding: 4px 6px; page-break-inside: avoid; break-inside: avoid;">
                                <div style="font-weight: normal; font-size: 9pt; margin-bottom: 1px;">Total number of packages or units (in words)</div>
                                <div>
                                    <span t-field="doc.total_packages_remark" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <p style="page-break-after: always;" />
                </t>
            </t>
        </t>
    </template>
</odoo>