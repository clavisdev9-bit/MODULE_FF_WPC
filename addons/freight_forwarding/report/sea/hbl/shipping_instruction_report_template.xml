<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="shipping_instruction_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            * { box-sizing: border-box; }
                            .page { font-size: 14pt; }
                            .page span { font-size: inherit; }
                            .container-fluid { width: 100%; }

                            /* ── Table (pakai nama class bawaan .table supaya menang cascade) ── */
                            .table { width: 100%; border-collapse: collapse; }
                            .table, .table th, .table td { border: none !important; }
                            .table td, .table th {
                                font-size: 12pt !important;
                                padding: 8px 10px !important;
                                vertical-align: top;
                                line-height: 1.6;
                            }

                            .si-label { font-weight: 400; font-size: 12pt; margin-bottom: 2px; }
                            .si-header-company { font-size: 16pt; font-weight: bold; color: #1e1c1c; }
                            .si-header-sub { font-size: 12pt; font-weight: 500; line-height: 1.5; }
                            .si-title { text-align: center; font-weight: 400; font-size: 14pt; margin: 24px 0 14px 0; }
                            .si-inline { display: table; width: 100%; }
                            .si-inline-row { display: table-row; }
                            .si-inline-label { display: table-cell; font-weight: 400; width: 90px; white-space: nowrap; padding-bottom: 4px; padding-left: 15px; }
                            .si-inline-colon { display: table-cell; width: 12px; }
                            .si-inline-value { display: table-cell; }

                            .no-left-border tr > th:first-child,
                            .no-left-border tr > td:first-child { border-left: hidden !important; }
                            .no-right-border tr > th:last-child,
                            .no-right-border tr > td:last-child { border-right: hidden !important; }
                            .border-dark { border: none !important; }
                            .text-center { text-align: center; }
                            .mb-0 { margin-bottom: 0; }
                            .mt-0 { margin-top: 0; }
                        </style>

                        <div class="container-fluid">
                            <!-- Letterhead -->
                            <table style="width:100%; border-collapse: collapse; border: none !important; margin-bottom: 6px;">
                                <tr>
                                    <td style="border:none !important; width: 135px; vertical-align: top;">
                                        <img src="data:image/png;base64,"
                                            style="height: 145px; width: auto;" />
                                    </td>
                                    <td style="border:none !important; vertical-align: top;">
                                        <div class="si-header-company">PT. WINDU PERSADA CARGO</div>
                                        <div class="si-header-sub">Jl. Kesehatan Raya No.54B, Tanah Abang IV, Jakarta Pusat 10160 - Indonesia</div>
                                        <div class="si-header-sub">Telp : (62-21) 345 0605, 345 8305 (Hunting) Fax : (62-21) 345 8307-08, Homepage: www.wpclogistics.com</div>
                                    </td>
                                </tr>
                            </table>

                            <div class="si-title">SHIPPING INSTRUCTION</div>

                            <!-- Row 0: Empty spacer row -->
                            <table class="table table-bordered border-dark mb-0 no-left-border no-right-border">
                                <tr>
                                    <td colspan="2">&#160;</td>
                                </tr>
                            </table>

                            <!-- Row 1: Shipper (left) | Date/To/Attn/TEL/FAX/Booking No./Job No./STAFF (right) -->
                            <table class="table table-bordered border-dark mb-0 mt-0 no-left-border no-right-border">
                                <tr>
                                    <td style="width:55%;">
                                        <div class="si-label">Shipper</div>
                                        <div>
                                            <span t-field="doc.shipper_id.name" /><br />
                                            <span t-field="doc.shipper_id.street" />
                                            <span t-if="doc.shipper_id.city">, <span t-field="doc.shipper_id.city" /></span>
                                            <br />
                                            <span t-field="doc.shipper_id.phone" />
                                        </div>
                                    </td>
                                    <td style="width:45%;">
                                        <div class="si-inline">
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Date</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.booking_id.booking_date"
                                                        t-options="{'widget': 'date'}" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">To</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.shipping_line_id.name" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Attn</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">&#160;</div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">TEL</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.shipping_line_id.phone" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">FAX</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">&#160;</div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Booking No.</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.booking_id.name" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">Job No.</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-field="doc.job_no" />
                                                </div>
                                            </div>
                                            <div class="si-inline-row">
                                                <div class="si-inline-label">STAFF</div>
                                                <div class="si-inline-colon">:</div>
                                                <div class="si-inline-value">
                                                    <span t-esc="doc.env.user.name" />
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 2: Consignee -->
                                <tr>
                                    <td colspan="2">
                                        <div class="si-label">Consignee</div>
                                        <div>
                                            <span t-field="doc.consignee_id.name" /><br />
                                            <span t-field="doc.consignee_id.city" /><br />
                                            <span t-field="doc.consignee_id.phone" />
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 3: Notify Party -->
                                <tr>
                                    <td colspan="2">
                                        <div class="si-label">Notify Party</div>
                                        <div>
                                            <t t-set="same_notify" t-value="doc.notify_id and doc.notify_id == doc.consignee_id" />
                                            <t t-if="same_notify">
                                                <strong>SAME AS CONSIGNEE</strong>
                                            </t>
                                            <t t-else="">
                                                <span t-field="doc.notify_id.name" /><br />
                                                <span t-field="doc.notify_id.city" /><br />
                                                <span t-field="doc.notify_id.phone" />
                                            </t>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Row 4: Feeder Vessel | Place of Receipt -->
                                <tr>
                                    <td>
                                        <div class="si-label">Feeder Vessel</div>
                                        <div><span t-field="doc.feeder_vessel_id.name" /></div>
                                    </td>
                                    <td>
                                        <div class="si-label">Place of Receipt</div>
                                        <div><span t-field="doc.place_of_receipt_id.name" /></div>
                                    </td>
                                </tr>

                                <!-- Row 5: Mother Vessel | Port of Loading -->
                                <tr>
                                    <td>
                                        <div class="si-label">Mother Vessel</div>
                                        <div><span t-field="doc.mother_vessel_id.name" /></div>
                                    </td>
                                    <td>
                                        <div class="si-label">Port of Loading</div>
                                        <div><span t-field="doc.port_of_loading_id.name" /></div>
                                    </td>
                                </tr>

                                <!-- Row 6: Port of Discharge | Place of Delivery | No. of Original B/L -->
                                <tr>
                                    <td>
                                        <div class="si-label">Port of Discharge</div>
                                        <div><span t-field="doc.port_of_discharge_id.name" /></div>
                                    </td>
                                    <td>
                                        <table style="width:100%; border-collapse:collapse; border:none !important;">
                                            <tr>
                                                <td style="border:none !important; width:65%; padding:0 !important;">
                                                    <div class="si-label">Place of Delivery</div>
                                                    <div><span t-field="doc.place_of_delivery_id.name" /></div>
                                                </td>
                                                <td style="border:none !important; width:35%; padding:0 !important;">
                                                    <div class="si-label">No. of Original B/L</div>
                                                    <div><span t-field="doc.original_bl_no" /></div>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Cargo item table -->
                            <table class="table table-bordered border-dark mb-0 mt-0 no-left-border no-right-border">
                                <tr>
                                    <td style="width:15%;"><div class="si-label">Container / Seal No. Marks &amp; Nos.</div></td>
                                    <td style="width:15%;"><div class="si-label">No. and Kind of Package</div></td>
                                    <td style="width:45%;"><div class="si-label">Description of Goods</div></td>
                                    <td style="width:25%;"><div class="si-label">Weight<br />Measurement</div></td>
                                </tr>
                                <t t-foreach="doc.cargo_info_ids" t-as="cargo">
                                    <tr>
                                        <td>
                                            <span t-field="cargo.container_no" /><br />
                                            <span t-if="cargo.seal_no" t-field="cargo.seal_no" /><br />
                                            <span t-if="cargo.marks_and_no" t-field="cargo.marks_and_no" />
                                        </td>
                                        <td>
                                            <span t-field="cargo.quantity" />
                                            <span t-field="cargo.package_type_id.name" />
                                        </td>
                                        <td>
                                            <span t-field="cargo.description_of_goods" />
                                        </td>
                                        <td>
                                            <span t-field="cargo.gross_weight" /> KGS<br />
                                            <span t-if="cargo.total_volume" t-field="cargo.total_volume" />
                                            <span t-elif="cargo.volume" t-field="cargo.volume" /> CBM
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        SHIPPED ON BOARD DATED: 
                                        <span t-field="doc.booking_id.booking_date"
                                            t-options="{'widget': 'date'}" />
                                    </td>
                                </tr>
                            </table>

                            <!-- Total number of packages -->
                            <table class="table table-bordered border-dark mt-0 no-left-border no-right-border">
                                <tr>
                                    <td>
                                        <div class="si-label" style="font-weight: normal;">Total number of packages or units (in words)</div>
                                        <div>
                                            <span t-field="doc.total_packages_remark" />
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <p style="page-break-after: always;" />
                </t>
            </t>
        </t>
    </template>
</odoo>